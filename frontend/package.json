{
  "name": "web-notebook-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "generate:webnb": "node scripts/generate-webnb.mjs",
    "check:webnb": "node scripts/generate-webnb.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.33",
    "rolldown": "1.2.19",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
